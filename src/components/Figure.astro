---
import { FIGURES } from '../lib/content';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props {
  name: string;
  lang: Lang;
}

const { name, lang } = Astro.props;
const svg = FIGURES[name] ?? FIGURES.placeholder;
const isPlaceholder = name.startsWith('placeholder') || !(name in FIGURES);
---

<span class="figure">
  <Fragment set:html={svg} />
  {isPlaceholder && <span class="figure-badge">{t(lang).placeholderFigure}</span>}
</span>
