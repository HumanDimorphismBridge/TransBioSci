---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { routes } from '../../lib/routes';
import { mapLangs } from '../../lib/paths';

// Keep this page out of the static build while it is hidden.
export function getStaticPaths(): { params: { lang: Lang } }[] {
  return [];
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
// No language switch on this page; one shared set of records in both interface languages.
const alternates = mapLangs(routes.sources);
const columns = [s.colMaterial, s.colAuthor, s.colSource, s.colLicense, s.colTerms];
---

<BaseLayout
  lang={lang}
  title={s.sourcesTitle}
  header={{ start: { kind: 'back', href: routes.home(lang), label: s.backHome }, title: s.sourcesTitle }}
  breadcrumbs={[{ label: s.home, href: routes.home(lang) }, { label: s.sourcesTitle }]}
  alternates={alternates}
>
  <h1 class="visually-hidden">{s.sourcesTitle}</h1>
  <section class="panel">
    <p>{s.sourcesIntro}</p>
    <p class="notice">{s.sourcesLicense}</p>
    <div class="table-wrap">
      <table class="data-table">
        <caption>{s.sourcesTableCaption}</caption>
        <thead>
          <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
        </thead>
        <tbody>
          <tr>
            <td class="empty" colspan={columns.length}>{s.sourcesEmpty}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
