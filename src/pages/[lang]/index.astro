---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import Card from '../../components/Card.astro';
import type { Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { routes } from '../../lib/routes';
import { langPaths, mapLangs } from '../../lib/paths';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const s = t(lang);
const alternates = mapLangs(routes.home);

const entries = [
  { href: routes.transEntry(lang), title: s.transTitle, description: s.transCardDesc, figure: 'entry-trans' },
  { href: routes.dimorphismEntry(lang), title: s.dimorphismTitle, description: s.dimorphismCardDesc, figure: 'entry-dimorphism' },
  { href: routes.guestbook(lang), title: s.guestbookTitle, description: s.guestbookCardDesc, figure: 'entry-guestbook' },
  { href: routes.contact(lang), title: s.contactTitle, description: s.contactCardDesc, figure: 'entry-contact' },
];
---

<BaseLayout
  lang={lang}
  title={s.siteName}
  header={{ start: { kind: 'logo' } }}
  breadcrumbs={[{ label: s.home }]}
  alternates={alternates}
>
  <LangSwitch slot="controls" lang={lang} hrefs={alternates} />

  <section class="home-intro">
    <h1>{s.homeIntroTitle}</h1>
    <p>{s.homeIntro}</p>
  </section>

  <nav aria-label={s.home}>
    <ul class="entry-grid">
      {
        entries.map((entry) => (
          <li>
            <Card lang={lang} href={entry.href} title={entry.title} description={entry.description} figure={entry.figure} />
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>
