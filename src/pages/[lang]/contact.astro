---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import type { Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { routes } from '../../lib/routes';
import { langPaths, mapLangs } from '../../lib/paths';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const s = t(lang);
const alternates = mapLangs(routes.contact);
const email = 'adrianvoid@outlook.com';
---

<BaseLayout
  lang={lang}
  title={s.contactTitle}
  header={{ start: { kind: 'back', href: routes.home(lang), label: s.backHome }, title: s.contactTitle }}
  breadcrumbs={[{ label: s.home, href: routes.home(lang) }, { label: s.contactTitle }]}
  alternates={alternates}
>
  <LangSwitch slot="controls" lang={lang} hrefs={alternates} />

  <h1 class="visually-hidden">{s.contactTitle}</h1>
  <div class="contact">
    {lang === 'zh' && (
      <section class="panel">
        <h2>{s.aboutHeading}</h2>
        <p>Hi，我是Void，一名跨性别男性。</p>
      </section>
    )}
    {lang === 'en' && <section class="panel">
      <h2>{s.aboutHeading}</h2>
      <div class="about-copy">
        <p>{s.aboutIntro}</p>
        <p>{s.aboutResourcesLead}<a href="https://ftm.wiki/zh-cn/">FtM.wiki</a>{', '}<a href="https://2345.lgbt/zh-cn/">2345LGBT</a>{s.about2345Note}, and <a href="https://knowsex.net/">KnowSex</a>{s.aboutKnowSexNote}</p>
        <p>{s.aboutFocus}</p>
        <p>{s.aboutClosing}</p>
      </div>
    </section>}
    <section class="panel">
      <h2>{s.emailHeading}</h2>
      <p>{s.emailLabel}{lang === 'en' ? <a href={`mailto:${email}`}>{email}</a> : email}{s.emailDetails}</p>
    </section>
    <section class="panel">
      <h2>{s.supportHeading}</h2>
      <div class="qr-placeholder">{s.qrPlaceholder}</div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-copy {
    display: grid;
    gap: 0.75rem;
    text-align: start;
  }
</style>
