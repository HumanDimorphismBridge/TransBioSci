---
import RedirectPage from '../../../layouts/RedirectPage.astro';
import { DEFAULT_DIRECTION, DIRECTIONS, DIRECTION_LABEL, STORAGE_KEYS, type Lang } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { routes } from '../../../lib/routes';
import { langPaths } from '../../../lib/paths';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
---

<RedirectPage
  lang={lang}
  title={t(lang).transTitle}
  storageKey={STORAGE_KEYS.direction('trans')}
  targets={DIRECTIONS.map((d) => ({ value: d, label: DIRECTION_LABEL[d], href: routes.transIntro(lang, d) }))}
  defaultValue={DEFAULT_DIRECTION}
/>
