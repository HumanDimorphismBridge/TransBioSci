# Copy to .env for local development (.env is git-ignored). Both values are public.
# Leave either empty to build the guestbook as a disabled shell.
PUBLIC_GUESTBOOK_API_URL=http://localhost:8787
# Cloudflare's published Turnstile test site key that always passes (visible widget).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
