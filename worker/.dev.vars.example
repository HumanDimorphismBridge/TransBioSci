# Copy to .dev.vars for local development. .dev.vars is git-ignored.
# Random local-only value; production uses `wrangler secret put VISITOR_HASH_SECRET`.
VISITOR_HASH_SECRET=replace-with-a-long-random-string
# Cloudflare's published Turnstile test secret that always passes.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
